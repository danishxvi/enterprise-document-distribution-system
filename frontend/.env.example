# Copy to .env.local for local overrides. All values are optional.

# Set to "false" to talk to a running Spring Boot backend instead of the
# built in mock data. Defaults to true so the app runs with no backend.
VITE_USE_MOCK=true

# Base url for the REST API when mock mode is off. During local development
# the Vite proxy forwards /api to http://localhost:8080, so the default works.
VITE_API_BASE_URL=/api
